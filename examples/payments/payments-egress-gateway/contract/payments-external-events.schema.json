{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myorg.example/schemas/payments-external-events.schema.json",
  "title": "Payments external events",
  "description": "What the payments subsystem tells the rest of the bank. Owned by payments-egress-gateway. Add fields freely; a rename or a removal takes three deployments, guarded by the consumers' contract tests.",
  "oneOf": [
    { "$ref": "#/$defs/paymentCompleted" },
    { "$ref": "#/$defs/paymentFailed" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["id", "type", "timestamp", "partitionKey", "payment"],
      "properties": {
        "id": { "type": "string", "description": "The same outcome always has the same id: drop repeats." },
        "type": { "type": "string" },
        "timestamp": { "type": "integer", "description": "When the outcome happened, epoch milliseconds." },
        "partitionKey": { "type": "string", "description": "The payment id." },
        "tags": { "type": "object", "additionalProperties": { "type": "string" }, "description": "tags.source is payments-egress-gateway." },
        "payment": { "$ref": "#/$defs/payment" }
      }
    },
    "payment": {
      "type": "object",
      "required": ["id", "customerId", "amount", "currency", "submittedAt"],
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "description": "A decimal string, never a binary floating-point number." },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "submittedAt": { "type": "integer", "description": "Epoch milliseconds." }
      }
    },
    "paymentCompleted": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": { "type": { "const": "PAYMENTS.PAYMENT_COMPLETED" } }
    },
    "paymentFailed": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "required": ["reason"],
      "properties": {
        "type": { "const": "PAYMENTS.PAYMENT_FAILED" },
        "reason": { "enum": ["insufficient-funds", "rejected"] }
      }
    }
  }
}
